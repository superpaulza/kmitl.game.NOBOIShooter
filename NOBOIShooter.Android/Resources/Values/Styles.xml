<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Splash theme referenced by MainActivity and AndroidManifest.xml.
       Uses the game logo as the window background while the game boots. -->
  <style name="Theme.Splash" parent="@android:style/Theme.NoTitleBar.Fullscreen">
    <item name="android:windowBackground">@drawable/icon</item>
    <item name="android:windowNoTitle">true</item>
  </style>
</resources>
